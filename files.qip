set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

set_global_assignment -name SYSTEMVERILOG_FILE rtl/chip_pool_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-SpaceInvaders.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mw8080_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/invaders_sound.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/eeprom_93c46.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/zac1b1120_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/zac_snd.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dsnd_engine.sv
set_global_assignment -name VERILOG_FILE rtl/cpu/jt680x/jt680x.v
set_global_assignment -name VERILOG_FILE rtl/cpu/jt680x/jt680x_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/cpu/jt680x/jt680x_alu.v
set_global_assignment -name VERILOG_FILE rtl/cpu/jt680x/jt680x_regs.v
set_global_assignment -name SEARCH_PATH rtl/cpu/jt680x
set_global_assignment -name QIP_FILE rtl/sound/jt49/hdl/jt49.qip
set_global_assignment -name VHDL_FILE rtl/cpu/s2650/base/base_pack.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/s2650/sgs2650_pack.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/s2650/sgs2650.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/s2650/s2650_cpu.vhd
set_global_assignment -name SEARCH_PATH rtl

set_global_assignment -name QIP_FILE rtl/cpu/T80/T80.qip

set_global_assignment -name VERILOG_FILE rtl/mister_custom/pause.v
set_global_assignment -name VERILOG_FILE rtl/mister_custom/hiscore.v
# CTL-2026-10-25: shared input library (controllers.sv v2; this core holds the fleet master)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mister_custom/controllers.sv

# DPRAMSV-2026-10-25: VHDL dpram_dc replaced by the SystemVerilog one (same ports/generics + byteena); original:
# set_global_assignment -name VHDL_FILE rtl/ram_rom/dpram_dc.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/dpram_dc.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/artwork.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/art_resample.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/png_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/art/inflate.sv
