<misterromdescription>
    <name>Space Invaders II</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Invaders II</series>
    <year>1980</year>
    <manufacturer>Midway</manufacturer>
    <category>Shooter</category>

    <setname>invad2ct</setname>
    <parent>invad2ct</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="F5,81,8C,FF">
        <dip name="Service Mode" bits="0" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,2C/2C,1C/1C,1C/2C" values="2,3,0,1"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Bonus Life" bits="23" ids="1500,2000" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="invad2ct.zip">
        <part crc="51d02a71" name="invad2ct.h"/>
        <part crc="533ac770" name="invad2ct.g"/>
        <part crc="d1799f39" name="invad2ct.f"/>
        <part crc="291c1418" name="invad2ct.e"/>
        <part repeat="0x3000">00</part>
        <part crc="8d9a07c4" name="invad2ct.b"/>
        <part crc="efdabb03" name="invad2ct.a"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            14 90 00 00 F5 81 8C FF 00 00 00 00 00 00 09 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 04 03 00
            00 00 00 00 0D 0B 0C 00 00 00 00 00 00 00 00 00
            01 02 03 05 01 02 03 05 00 20 01 08 02 10 04 40
            0A 00 00 1C 00 E0 FF FF 20 1C 00 34 00 E0 80 FF
            00 34 00 4B 00 E0 00 FF 80 4B 00 79 00 E0 20 FF
            FF 79 00 90 00 E0 00 FF 80 90 00 A7 00 E0 20 FF
            20 A7 00 BE 00 E0 80 FF 00 BE 00 D5 00 E0 FF FF
            20 D5 00 EC 00 E0 FF 80 00 EC 02 04 00 E0 FF 20
            20
        </part>
    </rom>

    <remark>Space Invaders II (Midway, Cocktail)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
