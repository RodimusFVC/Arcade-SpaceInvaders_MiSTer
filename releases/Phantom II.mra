<misterromdescription>
    <name>Phantom II</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Phantom II</series>
    <year>1979</year>
    <manufacturer>Midway</manufacturer>
    <category>Shooter</category>

    <setname>phantom2</setname>
    <parent>phantom2</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,26,FF,FF">
        <dip name="Coinage" bits="8" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Game Time" bits="9,10" ids="45 seconds + 20 extended (at 20 points),60 seconds + 25 extended (at 25 points),75 seconds + 30 extended (at 30 points),90 seconds + 35 extended (at 35 points)"/>
        <dip name="Unused" bits="11" ids="Off,On"/>
        <dip name="Unused" bits="12" ids="Off,On"/>
        <dip name="Service Mode" bits="13" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="14" ids="Off,On"/>
        <dip name="Unused" bits="15" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="phantom2.zip">
        <part crc="0e3c2439" name="phantom2.h"/>
        <part crc="e8df3e52" name="phantom2.g"/>
        <part crc="30e83c6d" name="phantom2.f"/>
        <part crc="8c641cac" name="phantom2.e"/>
        <part repeat="0x1E000">00</part>
        <part crc="dcdd2927" name="p2clouds.f2"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            14 00 00 00 FF 26 FF FF 00 00 00 00 07 00 01 00
            01 02 03 04 05 11 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            06 01 02 05 06 01 02 05 00 01 02 00 04 08 10 00
            01 00 02 04 00 E0 9F 9F FF
        </part>
    </rom>

    <remark>Phantom II (Midway)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
