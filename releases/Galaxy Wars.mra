<misterromdescription>
    <name>Galaxy Wars</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxy Wars</series>
    <year>1979</year>
    <manufacturer>Universal</manufacturer>
    <category>Shooter</category>

    <setname>galxwars</setname>
    <parent>galxwars</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="40,89,01,FF">
        <dip name="Lives" bits="16,17" ids="2,3,4,5"/>
        <dip name="Bonus Life" bits="19" ids="3000,5000"/>
        <dip name="Coinage" bits="23" ids="1C/1C,1C/2C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="galxwars.zip">
        <part crc="937796f4" name="univgw3.0"/>
        <part crc="4b86e7a6" name="univgw4.1"/>
        <part crc="47a187cd" name="univgw5.2"/>
        <part crc="7b7d22ff" name="univgw6.3"/>
        <part repeat="0x3000">00</part>
        <part crc="0871156e" name="univgw1.4"/>
        <part crc="6036d7bf" name="univgw2.5"/>
        <part repeat="0x1B800">00</part>
        <part crc="aac24f34" name="01.1"/>
        <part crc="2bdf83a0" name="02.2"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            00 10 01 00 40 89 01 FF 00 00 00 00 01 60 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Galaxy Wars (Universal Set 1)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
