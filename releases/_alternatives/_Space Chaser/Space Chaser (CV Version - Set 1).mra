<misterromdescription>
    <name>Space Chaser (CV Version - Set 1)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Chaser</series>
    <year>1979</year>
    <manufacturer>Taito</manufacturer>
    <category>Shooter</category>

    <setname>schasercv</setname>
    <parent>schaser</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,01,00,FF">
        <dip name="Lives" bits="16" ids="3,4"/>
        <dip name="Difficulty" bits="19" ids="Easy,Hard"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="schasercv.zip|schaser.zip">
        <part crc="bec2b16b" name="1"/>
        <part crc="9d25e608" name="2"/>
        <part crc="113d0635" name="3"/>
        <part crc="f3a43c8d" name="4"/>
        <part crc="47c84f23" name="5"/>
        <part crc="02ff2199" name="6"/>
        <part crc="87d06b88" name="7"/>
        <part crc="6dfaad08" name="8"/>
        <part repeat="0x2000">00</part>
        <part crc="3d1a2ae3" name="9"/>
        <part crc="037edb99" name="10"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            10 10 01 00 00 01 00 FF 00 00 00 00 02 02 05 01
            00 00 00 00 00 00 00 00 11 14 13 02 05 03 04 01
            00 0A 09 00 0D 0B 0C 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Space Chaser (CV Version - Set 1) (Taito)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
