<misterromdescription>
    <name>Rescate Lunar (Spanish Bootleg Of Lunar Rescue)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Lunar Rescue</series>
    <year>1980</year>
    <manufacturer>bootleg (Niemer S.A.)</manufacturer>
    <category>Shooter</category>

    <setname>resclunar</setname>
    <parent>lrescue</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,89,00,FF">
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="resclunar.zip|lrescue.zip">
        <part crc="6234e240" name="1-2716.h1"/>
        <part crc="67ab3599" name="2-2516.g1"/>
        <part crc="337b6266" name="3-2716.f1"/>
        <part crc="dd90ad9a" name="4-2716.e1"/>
        <part repeat="0x2000">00</part>
        <part crc="741212d4" name="5-2716.d1"/>
        <part crc="c8994fc7" name="6-8516.c1"/>
        <part crc="1adff5d7" name="7-2516.b1"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            00 10 01 00 FF 89 00 FF 00 00 00 00 00 00 07 01
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 15 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 DC 02 04 00 E0 20 FF 20 50 00 DC 00 E0 FF 80
            10 14 00 50 00 E0 FF 20 20 00 00 14 00 E0 20 FF
            20
        </part>
    </rom>

    <remark>Rescate Lunar (Spanish Bootleg Of Lunar Rescue) (Niemer S.A. Bootleg)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
