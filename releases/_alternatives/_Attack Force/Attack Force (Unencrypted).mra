        <part repeat="0x400">00</part>
        <part crc="a9eb4699" name="egs6.bin"/>
        <part crc="7e705388" name="egs7.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            06 00 01 00 FF 01 FF FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 00 00 00 05 03 04 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
