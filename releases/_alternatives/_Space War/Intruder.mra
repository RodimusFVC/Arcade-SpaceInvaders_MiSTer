<misterromdescription>
    <name>Intruder</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space War</series>
    <year>1980</year>
    <manufacturer>Konami (Game Plan license)</manufacturer>
    <category>Shooter</category>

    <setname>intruder</setname>
    <parent>spcewarl</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,8E,00,FF">
        <dip name="Lives" bits="8,9" ids="3,4,5,6"/>
        <dip name="Service Mode" bits="10" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="11" ids="1000,1500" values="1,0"/>
        <dip name="Display Coinage" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="23" ids="1 Coin/1 Or 2 Players,1 Coin/1 Player  2 Coins/2 Players"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="intruder.zip|spcewarl.zip">
        <part crc="bedc0078" name="la01-1.36"/>
        <part crc="43bc65c5" name="la02-1.35"/>
        <part crc="278ef9cf" name="la03-1.34"/>
        <part crc="5116b234" name="la04-1.33"/>
        <part repeat="0x1E000">00</part>
        <part crc="aac24f34" name="01.1"/>
        <part crc="2bdf83a0" name="02.2"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            00 10 01 00 00 8E 00 FF 00 00 00 00 01 60 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 0D 0B 0C 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Intruder (Konami (Game Plan License))</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
