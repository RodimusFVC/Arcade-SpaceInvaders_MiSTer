<misterromdescription>
    <name>Ozma Wars (Model Racing Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ozma Wars</series>
    <year>1979</year>
    <manufacturer>bootleg (Model Racing)</manufacturer>
    <category>Shooter</category>

    <setname>ozmawarsmr</setname>
    <parent>ozmawars</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,88,00,FF">
        <dip name="Energy" bits="16,17" ids="15000,20000,25000,35000"/>
        <dip name="Bonus Energy" bits="19" ids="15000,10000"/>
        <dip name="Coinage" bits="23" ids="1C/1C,1C/2C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="ozmawarsmr.zip|ozmawars.zip">
        <part crc="9300830e" name="73.1s"/>
        <part crc="957fc661" name="74.1pr"/>
        <part crc="cf8f4d6c" name="75.1n"/>
        <part crc="f51544a5" name="76.1m"/>
        <part crc="4a653fe6" name="77.1l"/>
        <part crc="fb3db187" name="78.1kj"/>
        <part crc="ed2d7c34" name="79.1h"/>
        <part crc="85728971" name="80.1g"/>
        <part repeat="0x2000">00</part>
        <part crc="df0cc633" name="81.1ef"/>
        <part crc="31b7692e" name="82.1d"/>
        <part crc="50257351" name="83.1c"/>
        <part crc="293303c9" name="84.1b"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            01 10 01 00 FF 88 00 FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Ozma Wars (Model Racing Bootleg)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
