        <part crc="ae59a629" name="oz8"/>
        <part repeat="0x2000">00</part>
        <part crc="df0cc633" name="oz9"/>
        <part crc="31b7692e" name="oz10"/>
        <part crc="660e934c" name="oz11"/>
        <part crc="8b969f61" name="oz12"/>
        <part repeat="0x1B000">00</part>
        <part crc="aac24f34" name="01.1"/>
        <part crc="2bdf83a0" name="02.2"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
