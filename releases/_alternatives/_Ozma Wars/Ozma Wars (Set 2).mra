<misterromdescription>
    <name>Ozma Wars (Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ozma Wars</series>
    <year>1979</year>
    <manufacturer>SNK</manufacturer>
    <category>Shooter</category>

    <setname>ozmawars2</setname>
    <parent>ozmawars</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,88,00,FF">
        <dip name="Energy" bits="16,17" ids="15000,20000,25000,35000"/>
        <dip name="Bonus Energy" bits="19" ids="15000,10000"/>
        <dip name="Coinage" bits="23" ids="1C/1C,1C/2C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="ozmawars2.zip|ozmawars.zip">
        <part crc="9300830e" name="oz1"/>
        <part crc="957fc661" name="oz2"/>
        <part crc="cf8f4d6c" name="oz3"/>
