<misterromdescription>
    <name>Space Phantoms (Bootleg Of Ozma Wars)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ozma Wars</series>
    <year>1979</year>
    <manufacturer>bootleg? (Zilec Games)</manufacturer>
    <category>Shooter</category>

    <setname>spaceph</setname>
    <parent>ozmawars</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,88,00,FF">
        <dip name="Energy" bits="16,17" ids="15000,20000,25000,35000"/>
        <dip name="Bonus Energy" bits="19" ids="15000,10000"/>
        <dip name="Coinage" bits="23" ids="1C/1C,1C/2C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="spaceph.zip|ozmawars.zip">
        <part crc="de84771d" name="sv01.bin"/>
        <part crc="957fc661" name="sv02.bin"/>
        <part crc="dbda38b9" name="sv03.bin"/>
        <part crc="f51544a5" name="sv04.bin"/>
        <part crc="98d02683" name="sv05.bin"/>
        <part crc="4ec390fd" name="sv06.bin"/>
        <part crc="170862fd" name="sv07.bin"/>
        <part crc="511b12cf" name="sv08.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="af1cd1af" name="sv09.bin"/>
        <part crc="31b7692e" name="sv10.bin"/>
        <part crc="50257351" name="sv11.bin"/>
        <part crc="a2a3366a" name="sv12.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            01 10 01 00 FF 88 00 FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Space Phantoms (Bootleg Of Ozma Wars) (Bootleg? (Zilec Games))</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
