<misterromdescription>
    <name>Solar Fight (Bootleg Of Ozma Wars)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ozma Wars</series>
    <year>1979</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>solfight</setname>
    <parent>ozmawars</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,88,00,FF">
        <dip name="Energy" bits="16,17" ids="15000,20000,25000,35000"/>
        <dip name="Bonus Energy" bits="19" ids="15000,10000"/>
        <dip name="Coinage" bits="23" ids="1C/1C,1C/2C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="solfight.zip|ozmawars.zip">
        <part crc="a4f2814e" name="solfight.m"/>
        <part crc="5657ec07" name="solfight.n"/>
        <part crc="ef9ce96d" name="solfight.p"/>
        <part crc="4f1ef540" name="solfight.r"/>
        <part repeat="0x2000">00</part>
        <part crc="3bc7d4c7" name="mw05"/>
        <part crc="3b6fb206" name="solfight.t"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            01 10 01 00 FF 88 00 FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Solar Fight (Bootleg Of Ozma Wars)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
