<misterromdescription>
    <name>Super Invader Attack (Bootleg Of The Invaders)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>The Invaders</series>
    <year>1979?</year>
    <manufacturer>bootleg (Sidam)</manufacturer>
    <category>Shooter</category>

    <setname>sia2650</setname>
    <parent>tinv2650</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="7F,85,FF,FF">
        <dip name="Lightning Speed" bits="9" ids="Slow,Fast"/>
        <dip name="Coinage" bits="10,12" ids="2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C"/>
        <dip name="Bonus Life" bits="13" ids="1000,1500"/>
        <dip name="Extended Play" bits="14" ids="No,Yes"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="sia2650.zip|tinv2650.zip">
        <part crc="a85550a9" name="42_1.bin"/>
        <part crc="48d5a3ed" name="44_2.bin"/>
        <part crc="d766e784" name="46_3.bin"/>
        <part repeat="0x800">00</part>
        <part crc="7bfed23e" name="06_inv.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            20 10 00 00 7F 85 FF FF 00 00 00 00 00 00 00 00
            13 14 11 16 00 05 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 04 03 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Super Invader Attack (Bootleg Of The Invaders) (Sidam Bootleg)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
