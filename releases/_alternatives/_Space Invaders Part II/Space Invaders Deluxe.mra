<misterromdescription>
    <name>Space Invaders Deluxe</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Invaders Part II</series>
