<misterromdescription>
    <name>Cosmic Monsters (Version II)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Invaders / Space Invaders M</series>
    <year>1979</year>
    <manufacturer>bootleg (Universal)</manufacturer>
    <category>Shooter</category>

    <setname>cosmicmo</setname>
    <parent>invaders</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,89,01,FF">
        <dip name="Lives" bits="16,17" ids="2,3,4,5"/>
        <dip name="Bonus Life" bits="19" ids="1500,2500"/>
        <dip name="Coinage" bits="23" ids="1C/1C,1C/2C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="cosmicmo.zip|invaders.zip">
        <part crc="d6e4e5da" name="ii-1.h1"/>
        <part crc="8f7988e6" name="ii-2.h2"/>
        <part crc="2d2e9dc8" name="ii-3.h3"/>
        <part crc="26cae456" name="ii-4.h4"/>
        <part repeat="0x3000">00</part>
        <part crc="b13f228e" name="ii-5.h5"/>
        <part crc="4ae1b9c4" name="ii-6.h6"/>
        <part crc="6a13b15b" name="ii-7.h7"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            00 10 01 00 FF 89 01 FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            03 00 02 04 00 E0 FF 8C FF 00 00 4C 00 E0 FF FF
            26 C5 02 04 00 E0 26 FF 26
        </part>
    </rom>

    <remark>Cosmic Monsters (Version II) (Universal Bootleg)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
