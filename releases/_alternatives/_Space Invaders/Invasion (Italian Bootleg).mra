<misterromdescription>
    <name>Invasion (Italian Bootleg)</name>
    <region>Italy</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Invaders / Space Invaders M</series>
    <year>1979</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>invasionb</setname>
    <parent>invaders</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="08,89,83,FD">
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="19" ids="1500,2500" values="1,0"/>
        <dip name="Laser Bonus Info" bits="23" ids="Off,On" values="1,0"/>
        <dip name="Coin counter" bits="26" ids="Disconnected,Connected"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="invasionb.zip|invaders.zip">
        <part crc="7a9b4485" name="invasionb_0.bin"/>
        <part crc="7c86620d" name="invasionb_1.bin"/>
        <part crc="ccaf38f6" name="invasionb_2.bin"/>
        <part repeat="0x800">00</part>
        <part crc="8ec9eae2" name="invasionb_5.bin"/>
        <part crc="ec0edb4a" name="invasionb_6.bin"/>
        <part crc="6aac1281" name="invasionb_7.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            02 10 01 00 08 89 83 FD 00 00 00 00 00 00 00 00
            00 00 00 00 05 03 04 00 11 14 13 00 05 03 04 12
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 00 02 04 00 E0 FF FF FF 14 00 4C 00 E0 20 FF
            20 00 00 14 10 86 20 FF 20 C6 00 E4 00 E0 FF 20
            20
        </part>
    </rom>

    <remark>Invasion (Italian Bootleg)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
