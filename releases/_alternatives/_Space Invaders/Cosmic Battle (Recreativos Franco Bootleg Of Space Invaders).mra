<misterromdescription>
    <name>Cosmic Battle (Recreativos Franco Bootleg Of Space Invaders)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Invaders / Space Invaders M</series>
    <year>1979</year>
    <manufacturer>bootleg (Recreativos Franco)</manufacturer>
    <category>Shooter</category>

    <setname>cosmicbat</setname>
    <parent>invaders</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,89,8B,FF">
        <dip name="Lives" bits="16" ids="2,3"/>
        <dip name="Pence Coinage" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="23" ids="2C/1C 50p/3C (+ Bonus Life),1C/1C 50p/5C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="cosmicbat.zip|invaders.zip">
        <part crc="6019a1aa" name="1.5m"/>
        <part crc="c12eab91" name="2.5n"/>
        <part crc="2a8d9cd5" name="3.5p"/>
        <part crc="4c77ce80" name="4.5r"/>
        <part crc="b2527c77" name="5.5s"/>
        <part crc="a883ff01" name="6.5t"/>
        <part crc="46e02fcf" name="7.5u"/>
        <part crc="ff88f38e" name="8.5v"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            00 10 01 00 FF 89 8B FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 12 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 00 02 04 00 E0 FF FF FF 14 00 4C 00 E0 20 FF
            20 00 00 14 10 86 20 FF 20 C6 00 E4 00 E0 FF 20
            20
        </part>
    </rom>

    <remark>Cosmic Battle (Recreativos Franco Bootleg Of Space Invaders)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
