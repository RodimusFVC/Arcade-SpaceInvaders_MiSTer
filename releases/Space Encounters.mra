    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="D1,D3,42,FF">
        <dip name="Bonus Life" bits="16,17" ids="2000 4000 8000,3000 6000 12000,4000 8000 16000,5000 10000 20000"/>
        <dip name="Coinage" bits="18,19" ids="2C/1C,1C/1C,2C/3C,1C/3C" values="1,0,3,2"/>
        <dip name="Bonus/Test Mode" bits="20,21" ids="Bonus On,Bonus Off,Cross Hatch,Test Mode" values="0,3,2,1"/>
        <dip name="Time" bits="22,23" ids="45,60,75,90"/>
    </switches>

