<misterromdescription>
    <name>Checkmate</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Checkmate</series>
    <year>1977</year>
    <manufacturer>Dave Nutting Associates / Midway</manufacturer>
    <category>Shooter</category>

    <setname>checkmat</setname>
    <parent>checkmat</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,04,00">
        <dip name="Coinage" bits="16" ids="1 Coin/1 or 2 Players,1 Coin/1 or 2 Players; 2 Coins/3 or 4 Players"/>
        <dip name="Unused" bits="17" ids="Off,On"/>
        <dip name="Rounds" bits="18,19" ids="2,3,4,5"/>
        <dip name="Unused" bits="20" ids="Off,On"/>
        <dip name="Language" bits="21,22" ids="English,Language 2,Language 3,Language 4"/>
        <dip name="Service Mode" bits="23" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="checkmat.zip">
        <part crc="3481a6d1" name="checkmat.h"/>
        <part crc="df5fa551" name="checkmat.g"/>
        <part crc="25586406" name="checkmat.f"/>
        <part crc="59330d84" name="checkmat.e"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            14 00 00 00 00 00 04 00 00 00 00 00 00 00 01 02
            01 02 03 04 09 0A 0B 0C 40 41 42 43 45 46 47 48
            00 00 00 00 00 00 00 00 13 14 4A 4B 00 00 00 11
            01 02 03 04 01 02 03 04 00 08 04 0C 00 08 04 0C
            00
        </part>
    </rom>

    <remark>Checkmate (Dave Nutting Associates / Midway)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
