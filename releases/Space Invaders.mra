<misterromdescription>
    <name>Space Invaders</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Invaders / Space Invaders M</series>
    <year>1978</year>
    <manufacturer>Taito / Midway</manufacturer>
    <category>Shooter</category>

    <setname>invaders</setname>
    <parent>invaders</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="08,09,00,F8">
        <dip name="Unknown" bits="0" ids="Off,On"/>
        <dip name="Unused" bits="24" ids="Off,On"/>
        <dip name="Unused" bits="25" ids="Off,On"/>
        <dip name="Unused" bits="26" ids="Off,On"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="19" ids="1000,1500" values="1,0"/>
        <dip name="Display Coinage" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="invaders.zip">
        <part crc="734f5ad8" name="9316b-0869_m739h.h1"/>
        <part crc="6bfaca4a" name="9316b-0856_m739g.g1"/>
        <part crc="0ccead96" name="9316b-0855_m739f.f1"/>
        <part crc="14e538b0" name="9316b-0854_m739e.e1"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            00 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 28 29 00 05 03 04 2A 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Space Invaders / Space Invaders M (Taito / Midway)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
