<misterromdescription>
    <name>M-4</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>M-4</series>
    <year>1977</year>
    <manufacturer>Midway</manufacturer>
    <category>Shooter</category>

    <setname>m4</setname>
    <parent>m4</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="P1 Trigger,P1 Reload,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,14,FF">
        <dip name="Coinage" bits="16,17" ids="2 Coins per Player,2 Coins/1 or 2 Players,1 Coin per Player,1 Coin/1 or 2 Players" values="2,3,0,1"/>
        <dip name="Game Time" bits="18,19" ids="60 seconds,70 seconds,80 seconds,90 seconds"/>
        <dip name="Service Mode" bits="20" ids="Off,On" values="1,0"/>
        <dip name="Extended Play" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Extended Play At" bits="22,23" ids="70,80,100,110" values="3,1,2,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="m4.zip">
        <part crc="9ee2a0b5" name="m4.h"/>
        <part crc="0e84b9cb" name="m4.g"/>
        <part crc="9ded9956" name="m4.f"/>
        <part crc="b6983238" name="m4.e"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            14 00 00 00 FF FF 14 FF 00 00 00 00 00 00 01 00
            00 09 00 0A 0D 0E 00 00 11 01 13 02 05 06 14 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 02 03 08 01 02 03 08 00 80 02 08 04 10 00 00
            00
        </part>
    </rom>

    <remark>M-4 (Midway)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
