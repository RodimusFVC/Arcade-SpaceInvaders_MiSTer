<misterromdescription>
    <name>Rolling Crash / Moon Base</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Rolling Crash / Moon Base</series>
    <year>1979</year>
    <manufacturer>Nichibutsu</manufacturer>
    <category>Shooter</category>

    <setname>rollingc</setname>
    <parent>rollingc</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FE,88,08,FF">
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
        <dip name="Coin Info" bits="23" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="19" ids="RC=3000 / MB=1000,RC=5000 / MB=2000" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="rollingc.zip">
        <part crc="66fa50bf" name="rc01.a4"/>
        <part crc="61c06ae4" name="rc02.c4"/>
        <part crc="77e39fa0" name="rc03.e4"/>
        <part crc="3fdfd0f3" name="rc04.f4"/>
        <part crc="c26a8f5b" name="rc05.h4"/>
        <part crc="0b98dbe5" name="rc06.l4"/>
        <part crc="6242145c" name="rc07.a5"/>
        <part crc="d23c2ef1" name="rc08.c5"/>
        <part repeat="0x2000">00</part>
        <part crc="2e2c5b95" name="rc09.e4"/>
        <part crc="ef94c502" name="rc10.f4"/>
        <part crc="a3164b18" name="rc11.h4"/>
        <part crc="2052f6d9" name="rc12.l4"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            02 10 01 00 FE 88 08 FF 00 00 00 00 05 00 06 01
            00 04 03 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 15 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Rolling Crash / Moon Base (Nichibutsu)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
