<misterromdescription>
    <name>Dodgem</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Dodgem</series>
    <year>1979</year>
    <manufacturer>Zaccaria</manufacturer>
    <category>Shooter</category>

    <setname>dodgem</setname>
    <parent>dodgem</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="7F,04,FF,00">
        <dip name="Lives" bits="8" ids="3,4"/>
        <dip name="Time" bits="9" ids="Off,On"/>
        <dip name="Coinage" bits="10,12" ids="2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C"/>
        <dip name="Show High Scores" bits="13" ids="Off,On"/>
        <dip name="Unknown" bits="14" ids="Off,On"/>
        <dip name="Unknown" bits="15" ids="Off,On"/>
        <dip name="Difficulty" bits="24,25" ids="Very Easy,Easy,Medium,Hard"/>
        <dip name="Unknown" bits="26" ids="Off,On"/>
        <dip name="Unknown" bits="27" ids="Off,On"/>
        <dip name="Unknown" bits="28" ids="Off,On"/>
        <dip name="Unknown" bits="29" ids="Off,On"/>
        <dip name="Unknown" bits="30" ids="Off,On"/>
        <dip name="Unknown" bits="31" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="dodgem.zip">
        <part crc="a327b57d" name="rom1.bin"/>
        <part crc="2a06ec74" name="rom2.bin"/>
        <part crc="e9ed656d" name="rom3.bin"/>
        <part crc="ecbfd906" name="rom4.bin"/>
        <part crc="bdae09fe" name="rom5.bin"/>
        <part crc="e131eacf" name="rom6.bin"/>
        <part repeat="0x800">00</part>
        <part crc="004b26d2" name="93451.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            21 00 00 00 7F 04 FF 00 00 00 00 00 00 00 00 00
            13 14 16 11 00 05 00 00 00 00 00 00 00 00 00 00
            01 02 00 00 04 03 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 00 08 D0 00 00 33 FF E6
        </part>
    </rom>

    <remark>Dodgem (Zaccaria)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
