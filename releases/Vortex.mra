<misterromdescription>
    <name>Vortex</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Vortex</series>
    <year>1980</year>
    <manufacturer>Zilec Electronics</manufacturer>
    <category>Shooter</category>

    <setname>vortex</setname>
    <parent>vortex</parent>
    <mameversion>0289</mameversion>
    <rbf>SpaceInvaders</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,89,8F,FF">
        <dip name="Unknown" bits="16" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="18" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="19" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="23" ids="2C/1C,1C/1C"/>
    </switches>

    <!-- Index 0: CPU 0x0000-0x7FFF (MAME maincpu) -->
    <rom index="0" md5="none" zip="vortex.zip">
        <part crc="577417a6" name="1.t36"/>
        <part crc="126d0049" name="2.t35"/>
        <part crc="4a2510b3" name="3.t34"/>
        <part crc="da0274fe" name="4.t33"/>
        <part repeat="0x2000">00</part>
        <part crc="a3de49d6" name="5.t32"/>
        <part crc="271085d0" name="6.t31"/>
    </rom>

    <!-- Index 1: board variant, flags, sound board, input map, colour overlay (see Arcade-SpaceInvaders.sv) -->
    <rom index="1">
        <part>
            07 10 01 02 FF 89 8F FF 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 11 14 13 00 05 03 04 00
            00 00 00 00 05 03 04 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00
        </part>
    </rom>

    <remark>Vortex (Zilec Electronics)</remark>
    <mratimestamp>20260930000000</mratimestamp>
</misterromdescription>
